# 保留空目录占位文件
!.gitkeep

# 本地编辑器 / 工具配置，不上传
.vscode/
.claude/
.workbuddy/
AGENTS.md

# ModelSim / Questa 自动生成的仿真产物，不上传
sim/programs/work/
sim/programs/b2_hotspots_*/
sim/results/b2_hotspots_*/report_ratio_work/
sim/programs/transcript
sim/programs/vsim_stacktrace.vstf
sim/programs/*.wlf
sim/programs/*.vcd
sim/programs/*.log
sim/programs/backup/

# CoreMark 编译中间产物，不上传
tests/coremark/build/**/*.o
tests/coremark/build/*.elf
tests/coremark/build/*.map
tests/coremark/build/*.dis
tests/coremark/build/*.bin
tests/coremark/build/coremark_build_info.h
tests/coremark/build/**/coremark_build_info.h
tests/coremark/build/sim_validation/
tests/coremark/build/sim_performance/
tests/coremark/build/official/
fpga/pds/coremark_official/**/*.elf
fpga/pds/_backup_coremark_selection_*/
sim/programs/coremark_official_work/
tests/coremark/_backup_pre_build_report_20261010/

# CoreMark 仿真镜像：保留上传，也可以重新make直接跑仿真
!tests/coremark/build/imem.hex
!tests/coremark/build/dmem.hex

# 常见临时文件
*.tmp
*.bak
*.swp
*~
# 会话导出（体积大，不入库）
_session_export/

# ===== 重建为全新仓库时补齐 =====

# 脚本里 %SystemDrive% 未展开而误建的目录（内含 Windows 缓存 .db，绝不能入库）
%SystemDrive%/

# 临时 / 备份 / 派生目录
tmp/
_pdf_pages/
_backup_*/
*_backup_*/
transcript
*.bak_*

# Questa / ModelSim 自动生成的仿真库与数据库（可由源码重新编译生成）
@_opt/
*.qpg
*.qdb
*.qtl
*.wlf
*.vstf

# 编译产物补齐（原规则只覆盖 tests/coremark/build，这里覆盖全仓库）
*.dump
*.dis
*.map
*.elf
fpga/pds/**/*.zip

# 编译器中间文件和可由 HEX/DAT 重新生成的二进制
*.o
*.a
*.d
*.bin
*.gcda
*.gcno

# tests 下各构建目录中的 HEX/DAT 是构建副本；FPGA/PDS 交付目录里的镜像保留
tests/**/build/**/*.hex
tests/**/build/**/*.dat
tests/**/coremark_build_info.h

# PDS CoreMark 包里的过程性构建信息；正式镜像和板测日志继续纳入版本管理
fpga/pds/coremark_*/**/build.log
fpga/pds/coremark_*/**/build_log.txt
fpga/pds/coremark_*/**/coremark_build_info.h
fpga/pds/coremark_*/**/zba_instructions.txt

# 临时 ModelSim 工作库（对应脚本和结果快照保存在 sim/results）
sim/programs/btb_*/
sim/programs/*_work/

# 可重建的官方源码下载压缩包和编译过程日志
tests/**/official_HEAD.zip
tests/**/upstream_HEAD.zip
tests/**/build.log
tests/**/*_build.log
tests/**/*_regenerate_*.log

# 官方源码下载副本与临时重建工作区；项目使用的 CoreMark 源码保留在 tests/coremark/src/
tests/coremark_official_reclone_20261011/official_source/
tests/coremark_official_reclone_20261011/rebuild_workspace/

# 通用构建目录规则之后恢复仓库根 CoreMark 仿真镜像
!tests/coremark/build/imem.hex
!tests/coremark/build/dmem.hex
